# SyncWave Environment Configuration
# Copy this file to .env and fill in your values.

# Server port (Render sets this automatically)
PORT=8080

# Groq API key for AI text completion (optional)
# Get one at https://console.groq.com
GROQ_API_KEY=

# Log level: "info" (default) or "debug"
LOG_LEVEL=info

# PostgreSQL DSN (optional). If empty, SyncWave runs in-memory only.
# Example: postgres://user:pass@localhost:5432/syncwave?sslmode=disable
DATABASE_URL=

# Persist a full room snapshot every N operations (default: 25)
SNAPSHOT_EVERY=25

# Enable signed websocket sessions by setting AUTH_SECRET.
# If empty, auth is disabled and sessions are not required.
AUTH_SECRET=

# Session token TTL in minutes (default: 480 = 8h)
SESSION_TTL_MIN=480

# Optional per-room keys JSON. Rooms listed here require matching room_key query param.
# Example: {"project-plan":"secret123","finance":"room-pass"}
ROOM_KEYS_JSON={}

# Optional comma-separated list of allowed browser origins for CORS and WS upgrades.
# Leave empty to allow all origins (development default).
# Example: ALLOWED_ORIGINS=https://syncwave.example.com,https://staging-syncwave.example.com
ALLOWED_ORIGINS=

# Optional Redis URL for cross-instance operation fanout.
# Example: redis://localhost:6379/0
REDIS_URL=
