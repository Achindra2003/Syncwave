# SyncWave Environment Configuration
# Copy this file to .env and fill in your values.

# Server port (Render sets this automatically)
PORT=8080

# Groq API key for AI text completion (optional)
# Get one at https://console.groq.com
GROQ_API_KEY=

# Supabase/Postgres connection string (required for durable docs)
# Example: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Log level: "info" (default) or "debug"
LOG_LEVEL=info

# Optional comma-separated list of allowed browser origins for CORS and WS upgrades.
# Leave empty to allow all origins (development default).
# Example: ALLOWED_ORIGINS=https://syncwave.example.com,https://staging-syncwave.example.com
ALLOWED_ORIGINS=
